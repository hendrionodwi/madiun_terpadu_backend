APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

MOBILE_PASSWORD_RESET_URL=madiunterpadu://auth/reset-password

MIDTRANS_SERVER_KEY=
MIDTRANS_SIGNATURE_SECRET=
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_ALLOW_MOCK=false

RAJAONGKIR_ENABLED=false
RAJAONGKIR_API_KEY=
RAJAONGKIR_BASE_URL=https://rajaongkir.komerce.id/api/v1
RAJAONGKIR_COURIERS=jne:jnt:sicepat:anteraja:pos
RAJAONGKIR_CONNECT_TIMEOUT=3
RAJAONGKIR_TIMEOUT=10
RAJAONGKIR_DESTINATION_CACHE_SECONDS=604800
RAJAONGKIR_COST_CACHE_SECONDS=900
RAJAONGKIR_TRACKING_POLL_MINUTES=180
RAJAONGKIR_TRACKING_DAILY_LIMIT=80
RAJAONGKIR_TRACKING_BATCH_SIZE=20
MARKETPLACE_AUTO_COMPLETE_HOURS=48
MARKETPLACE_SIMULATION_AUTO_COMPLETE_MINUTES=2
